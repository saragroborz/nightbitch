<div class="hover-sound-container">
  <img 
    id="hoverImage" 
    src="https://images.squarespace-cdn.com/content/66acfe3c93f23c276bedb99e/4dfb108c-2a34-4d95-9de0-fcf4deaa2a50/sarabiotic-sonar-garden-code-installation.png?content-type=image%2Fpng" 
    alt="Interactive Image">
</div>

<style>
  .hover-sound-container {
    max-width: 100%;
    display: flex;
    justify-content: center;
    padding: 1rem;
  }

  .hover-sound-container img {    
    max-width: 100%;
    height: auto;
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'  width='40' height='48' viewport='0 0 100 100' style='fill:black;font-size:24px;'><text y='50%'>🌳</text></svg>")
      16 0, auto;
  }
</style>

<!-- Include Tone.js library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.25/Tone.min.js"></script>

<script type="text/javascript">
// Create a darker, complex sound using FMSynth for eerie textures
const synth = new Tone.FMSynth({
  harmonicity: 0.3,
  modulationIndex: 10,
  modulationType: "triangle",
  oscillator: { type: "sine" },
  envelope: {
    attack: 1,
    decay: 1.5,
    sustain: 0.3,
    release: 2
  },
  modulationEnvelope: {
    attack: 0.5,
    decay: 1,
    sustain: 0.5,
    release: 2
  }
}).toDestination();

// Add effects
const reverb = new Tone.Reverb({ decay: 12, wet: 0.6 }).toDestination();
const delay = new Tone.PingPongDelay({ delayTime: '8n', feedback: 0.7, wet: 0.5 }).toDestination();
const chorus = new Tone.Chorus({ frequency: 1.5, delayTime: 3.5, depth: 0.7, wet: 0.4 }).toDestination();

synth.connect(reverb);
synth.connect(delay);
synth.connect(chorus);

const filter = new Tone.Filter(200, "lowpass").toDestination();
const lfo = new Tone.LFO("0.1hz", 50, 400).start();
lfo.connect(filter.frequency);
synth.connect(filter);

// Define darker, more dissonant chords
const chords = [
  ['A3', 'C4', 'Eb4', 'G4'],
  ['B3', 'D4', 'F4', 'A4'],
  ['C4', 'Eb4', 'Gb4', 'Bb4'],
  ['D3', 'F4', 'Ab4', 'C5'],
  ['E4', 'G4', 'Bb4', 'D5'],
  ['F3', 'Ab4', 'C5', 'Eb5'],
  ['G4', 'Bb4', 'Db5', 'F5']
];

const hoverImage = document.getElementById("hoverImage");
let playing = false;

// Start the music on click/tap
hoverImage.addEventListener('click', function() {
  if (!playing) {
    Tone.start();
    playing = true;
  }
});

hoverImage.addEventListener('mousemove', function(event) {
  if (playing) {
    const rect = hoverImage.getBoundingClientRect();
    const xPos = event.clientX - rect.left;
    const yPos = event.clientY - rect.top;

    const chordIndex = Math.floor(mapRange(yPos, 0, hoverImage.height, 0, chords.length));
    const chord = chords[chordIndex];
    playChordWithRandomRhythm(chord, 0.15);

    const reverbMix = mapRange(xPos, 0, hoverImage.width, 0, 1);
    reverb.wet.value = reverbMix;

    chorus.depth = mapRange(xPos, 0, hoverImage.width, 0.3, 0.8);
  }
});

const possibleDurations = ['16n', '32n', '8t'];

function playChordWithRandomRhythm(chord, velocity) {
  const startTime = Tone.now();
  chord.forEach((note) => {
    const randomDuration = possibleDurations[Math.floor(Math.random() * possibleDurations.length)];
    const randomOffset = Math.random() * 0.25;
    synth.triggerAttackRelease(note, randomDuration, startTime + randomOffset, velocity);
  });
}

function mapRange(value, inMin, inMax, outMin, outMax) {
  return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin;
}
</script>
